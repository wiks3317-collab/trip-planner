rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function tripDoc(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId));
    }

    function isLegacyTrip(tripId) {
      return !('authModelVersion' in tripDoc(tripId).data)
        || !('ownerUid' in tripDoc(tripId).data)
        || !('access' in tripDoc(tripId).data);
    }

    function isOwner(tripId) {
      return signedIn()
        && (tripDoc(tripId).data.ownerUid == request.auth.uid
          || tripDoc(tripId).data.access[request.auth.uid] == 'owner');
    }

    function role(tripId) {
      return signedIn()
        ? tripDoc(tripId).data.access[request.auth.uid]
        : null;
    }

    function canEdit(tripId) {
      return isOwner(tripId) || role(tripId) == 'owner' || role(tripId) == 'editor';
    }

    // 行程資料目前採「知道行程 ID／取得分享連結即可讀取」的模式。
    // 讀取權限與編輯權限分離：未綁定 UID 的訪客只能讀取，不能修改。
    // 使用者已接受行程內容不必作為私人資料保護；後續仍可再加入邀請碼或更細緻的讀取控管。
    function canReadTrip(tripId) {
      return signedIn();
    }

    match /trips/{tripId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.access[request.auth.uid] == 'owner'
        && request.resource.data.name is string
        && request.resource.data.members is list;

      // 過渡期：舊行程仍可被登入使用者讀取，讓既有資料不會因更新規則而立即失聯。
      allow get: if signedIn() && canReadTrip(tripId);
      allow list: if false;

      // 舊行程只能進行一次性認領：新資料必須把目前登入 UID 設為 owner。
      // 認領前的舊行程仍存在「任何已登入者都可能先認領」的過渡期風險，完成認領後即改由 UID 控管。
      allow update: if isOwner(tripId)
        || (signedIn()
          && isLegacyTrip(tripId)
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.access[request.auth.uid] == 'owner'
          && request.resource.data.authModelVersion == 2);
      allow delete: if false;

      match /days/{dayId} {
        allow read: if signedIn() && canReadTrip(tripId);
        allow create, update, delete: if signedIn() && (isLegacyTrip(tripId) || canEdit(tripId));

        match /spots/{spotId} {
          allow read: if signedIn() && canReadTrip(tripId);
          allow create, update, delete: if signedIn() && (isLegacyTrip(tripId) || canEdit(tripId));

          match /wishes/{wishId} {
            allow read: if signedIn() && canReadTrip(tripId);
            allow create, update, delete: if signedIn() && (isLegacyTrip(tripId) || canEdit(tripId));
          }
        }
      }

      match /expenses/{expenseId} {
        allow read: if signedIn() && canReadTrip(tripId);
        allow create, update, delete: if signedIn() && (isLegacyTrip(tripId) || canEdit(tripId));
      }

      match /accessRequests/{requestId} {
        allow create: if signedIn()
          && requestId == request.auth.uid
          && request.resource.data.requestedUid == request.auth.uid
          && request.resource.data.status == 'pending'
          && canReadTrip(tripId);
        allow get: if signedIn()
          && (isOwner(tripId)
            || requestId == request.auth.uid);
        allow list: if isOwner(tripId);
        allow update: if isOwner(tripId)
          || (signedIn()
            && resource.data.requestedUid == request.auth.uid
            && request.resource.data.requestedUid == resource.data.requestedUid
            && request.resource.data.status == resource.data.status);
        allow delete: if false;
      }
    }

    match /shortlinks/{code} {
      allow get: if signedIn();
      allow list: if false;
      // 行程分享代碼只能由該行程統籌人建立；同步清單代碼則由已登入使用者建立。
      allow create: if signedIn()
        && (
          (request.resource.data.type == 'trip'
            && request.resource.data.tripId is string
            && isOwner(request.resource.data.tripId))
          || request.resource.data.type == 'sync'
        );
      allow update, delete: if false;
    }
  }
}
