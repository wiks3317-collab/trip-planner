rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // 系統管理員：admins/{uid} 這份文件是否存在，由你在 Firebase Console 手動新增／刪除，
    // 前端完全沒有寫入權限（見下面 admins 的規則）。exists() 是 Rules 內建函式，
    // 不受目標文件自己的讀取規則限制，所以這裡不需要額外開放 admins 的 get 權限也能判斷。
    // 只認 Google 登入的管理員，匿名身份即使 UID 被誤加進 admins 也不算管理員。
    function isAdmin() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 具編輯權限的管理員：admins/{uid} 文件需另外設定 canEdit: true（在 Firebase Console 手動設定）。
    function isAdminEditor() {
      return isAdmin()
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('canEdit', false) == true;
    }

    // 可改成員權限與 UID 的管理員：admins/{uid} 文件需另外設定 canManageMembers: true。
    // 與 canEdit 分開，因為改 UID／權限等於能決定「誰能編輯這個行程」，風險較高。
    // 高風險操作（刪除行程、改成員與 UID）要求 15 分鐘內重新登入過，
    // 降低「登入狀態放很久被盜用」的風險。完全免費，不需要升級付費方案。
    function recentlyAuthenticated() {
      return request.time.toMillis() - request.auth.token.auth_time * 1000 < 15 * 60 * 1000;
    }

    function isAdminMemberManager() {
      return isAdmin()
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('canManageMembers', false) == true;
    }

    // 天數／景點的基本欄位驗證（寬鬆：欄位不存在或為 null 都放行，避免影響既有資料）。
    function validContentDoc(data) {
      return (!('title' in data) || data.title == null || (data.title is string && data.title.size() <= 500))
        && (!('blocks' in data) || data.blocks == null || (data.blocks is list && data.blocks.size() <= 500));
    }

    function tripDoc(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId));
    }

    function inviteDoc(code) {
      return get(/databases/$(database)/documents/shortlinks/$(code));
    }

    function isOwner(tripId) {
      return signedIn()
        && (((('ownerUid' in tripDoc(tripId).data) && tripDoc(tripId).data.ownerUid == request.auth.uid))
          || (('access' in tripDoc(tripId).data) && request.auth.uid in tripDoc(tripId).data.access
            && tripDoc(tripId).data.access[request.auth.uid] == 'owner'));
    }

    function role(tripId) {
      return signedIn()
        ? (('access' in tripDoc(tripId).data) && request.auth.uid in tripDoc(tripId).data.access
            ? tripDoc(tripId).data.access[request.auth.uid]
            : null)
        : null;
    }

    function canEdit(tripId) {
      return isOwner(tripId) || role(tripId) == 'owner' || role(tripId) == 'editor';
    }

    function validPermission(value) {
      return value == 'owner' || value == 'editor' || value == 'viewer';
    }

    function validMembers(data) {
      return data is list && data.size() > 0 && data.size() <= 100;
    }

    function validTripBase(data) {
      return data.name is string
        && data.name.size() > 0
        && data.name.size() <= 200
        && data.members is list
        && data.members.size() > 0
        && data.members.size() <= 100
        && data.access is map
        && data.authModelVersion == 2
        && data.ownerUid is string
        && data.access[data.ownerUid] == 'owner';
    }

    function validInvite(data, tripId) {
      return data.type == 'tripInvite'
        && data.tripId == tripId
        && data.createdBy is string
        && data.revoked is bool
        && (!('maxUses' in data) || data.maxUses == null || (data.maxUses is int && data.maxUses > 0 && data.maxUses <= 10000))
        && (!('usedCount' in data) || (data.usedCount is int && data.usedCount >= 0));
    }

    function validSyncShortlink(data) {
      return data.type == 'sync'
        && data.createdBy == request.auth.uid
        && data.list is list
        && data.list.size() <= 30
        && data.keys().hasOnly(['type', 'list', 'createdBy', 'createdAt']);
    }

    function validExpense(data) {
      return data.title is string
        && data.title.size() > 0
        && data.title.size() <= 500
        && data.amountCents is int
        && data.amountCents > 0
        && data.currency is string
        && data.currency.size() > 0
        && data.currency.size() <= 10
        && data.payerId is string
        && data.splitWith is list
        && data.date is string
        && data.date.size() > 0
        && data.date.size() <= 30
        && data.createdByUid is string;
    }

    function protectedTripFieldsUnchanged(tripId) {
      return request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.authModelVersion == resource.data.authModelVersion;
    }

    function membershipUnchanged(tripId) {
      return request.resource.data.members == resource.data.members
        && request.resource.data.access == resource.data.access;
    }

    // 行程主文件包含 members / access / ownerUid 等權限與成員資訊。
    // v21p3 起不再允許「只要登入就能讀取」；只有已綁定 UID 的成員或系統管理員能讀取。
    function canReadTrip(tripId) {
      return signedIn()
        && (isAdmin()
          || (('access' in tripDoc(tripId).data) && request.auth.uid in tripDoc(tripId).data.access));
    }

    // 未綁定使用者若要申請加入，必須提交有效的 tripInvite 代碼。
    // Rules 會直接驗證代碼所屬行程、未撤銷及未過期，避免前端自行偽造 tripId／inviteCode。
    function canRequestAccess(tripId) {
      return signedIn()
        && request.resource.data.inviteCode is string
        && exists(/databases/$(database)/documents/shortlinks/$(request.resource.data.inviteCode))
        && inviteDoc(request.resource.data.inviteCode).data.type == 'tripInvite'
        && inviteDoc(request.resource.data.inviteCode).data.tripId == tripId
        && inviteDoc(request.resource.data.inviteCode).data.revoked == false
        && (!('expiresAt' in inviteDoc(request.resource.data.inviteCode).data)
          || inviteDoc(request.resource.data.inviteCode).data.expiresAt == null
          || request.time < inviteDoc(request.resource.data.inviteCode).data.expiresAt);
    }

    // 行程「內容」（days / spots / wishes / expenses）只有已綁定成員身份的 UID，
    // 或是系統管理員，才能讀取。未綁定使用者不直接取得任何行程內容。
    function canReadContent(tripId) {
      return signedIn()
        && (isAdmin()
          || (('access' in tripDoc(tripId).data)
            && request.auth.uid in tripDoc(tripId).data.access
            && tripNotDeleted(tripId)));
    }

    // 行程是否處於「啟用中」：只有系統管理員能把 disabled 設成 true／false
    // （見下面 trips 的 update 規則裡專屬管理員的那個分支）。沒有 disabled 欄位、
    // 或 disabled 不是 true，一律視為啟用中，所以現有行程完全不受影響。
    // 停用後，包含統籌人在內的所有一般使用者都無法再新增／修改／刪除天數、景點、
    // 許願池留言與記帳明細，也不能改行程主文件；只有管理員能把它改回啟用。
    function tripNotDeleted(tripId) {
      return !('deleted' in tripDoc(tripId).data) || tripDoc(tripId).data.deleted != true;
    }

    // 已軟刪除的行程一律視同停用：一般使用者不能讀取內容、也不能寫入；只有管理員能還原。
    function tripActive(tripId) {
      return (!('disabled' in tripDoc(tripId).data) || tripDoc(tripId).data.disabled != true)
        && tripNotDeleted(tripId);
    }

    match /trips/{tripId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && validTripBase(request.resource.data)
        && request.resource.data.access[request.auth.uid] == 'owner';

      // v21p3：行程主文件包含成員與權限資訊，只允許已綁定成員或系統管理員讀取。
      allow get: if signedIn() && canReadTrip(tripId);
      // 一般使用者仍然不能列出所有行程；只有管理後台（admin.html，Google 登入 + admins/{uid} 存在）
      // 能列出行程主文件（名稱、成員數、建立時間等摘要），不代表能讀寫天數／景點／留言／帳務等子集合，
      // 那些仍然只開放給已綁定該行程 access 的 UID（見下面 canReadContent 與各子集合規則）。
      allow list: if isAdmin();

      allow update: if (
          isOwner(tripId)
          && tripActive(tripId)
          && protectedTripFieldsUnchanged(tripId)
          && validTripBase(request.resource.data)
        )
        || (
          signedIn()
          && canEdit(tripId)
          && tripActive(tripId)
          && !isOwner(tripId)
          && protectedTripFieldsUnchanged(tripId)
          && membershipUnchanged(tripId)
          // 編輯者只能改這些欄位（行程名稱、幣別、匯率、背景）；成員與權限只有統籌人能改。
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'currencies', 'fxRates', 'backgroundImageUrl', 'backgroundDim'])
        )

        // 系統管理員專用：只能切換 disabled／disabledAt／disabledBy 這三個欄位（停用／恢復行程），
        // 不能透過這個管道改名稱、成員、權限等其他欄位。故意不要求 tripActive(tripId)，
        // 否則已停用的行程會沒辦法被管理員自己改回啟用。
        || (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['disabled', 'disabledAt', 'disabledBy', 'disabledReason'])
          && (!('disabled' in request.resource.data) || request.resource.data.disabled is bool)
          && (!('disabledReason' in request.resource.data) || request.resource.data.disabledReason is string)
        )
        // 具編輯權限的管理員：只能改名稱、幣別、匯率、背景；成員／權限／擁有者仍只有統籌人能改。
        // 故意不要求 tripActive，讓管理員能在行程停用期間清理內容。
        || (
          isAdminEditor()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'currencies', 'fxRates', 'backgroundImageUrl', 'backgroundDim'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 200
        )
        // 軟刪除／還原：只能切換 deleted 相關欄位，資料本身完全保留。
        || (
          isAdminEditor()
          && recentlyAuthenticated()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['deleted', 'deletedAt', 'deletedBy', 'deletedReason'])
          && request.resource.data.deleted is bool
          && (!('deletedReason' in request.resource.data) || request.resource.data.deletedReason is string)
        )
        // 管理員調整成員權限與綁定 UID：members／access／ownerUid 必須一起改，且新的 ownerUid 必須是 owner。
        || (
          isAdminMemberManager()
          && recentlyAuthenticated()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['members', 'access', 'ownerUid'])
          && validMembers(request.resource.data.members)
          && request.resource.data.access is map
          && request.resource.data.ownerUid is string
          && request.resource.data.access[request.resource.data.ownerUid] == 'owner'
        );
      allow delete: if false;

      match /days/{dayId} {
        allow read: if canReadContent(tripId);
        allow create, update: if signedIn() && canEdit(tripId) && tripActive(tripId) && validContentDoc(request.resource.data);
        allow delete: if signedIn() && canEdit(tripId) && tripActive(tripId);
        allow create, update: if isAdminEditor() && validContentDoc(request.resource.data);
        allow delete: if isAdminEditor();

        match /spots/{spotId} {
          allow read: if canReadContent(tripId);
          allow create, update: if signedIn() && canEdit(tripId) && tripActive(tripId) && validContentDoc(request.resource.data);
          allow delete: if signedIn() && canEdit(tripId) && tripActive(tripId);
          allow create, update: if isAdminEditor() && validContentDoc(request.resource.data);
          allow delete: if isAdminEditor();

          // 許願池：已綁定成員（含唯讀）都可以留言，並且只能修改／刪除自己（authorUid）的留言；
          // 統籌人與編輯者維持原本權限（可管理所有留言、搬移景點時複製留言）。停用中的行程一律不可寫入。
          match /wishes/{wishId} {
            allow read: if canReadContent(tripId);
            allow update, delete: if isAdminEditor();
            allow create: if tripActive(tripId)
              && (canEdit(tripId)
                || (canReadContent(tripId)
                  && request.resource.data.authorUid == request.auth.uid));
            allow update: if tripActive(tripId)
              && (canEdit(tripId)
                || (canReadContent(tripId)
                  && resource.data.get('authorUid', null) == request.auth.uid
                  && request.resource.data.get('authorUid', null) == request.auth.uid));
            allow delete: if tripActive(tripId)
              && (canEdit(tripId)
                || (canReadContent(tripId)
                  && resource.data.get('authorUid', null) == request.auth.uid));
          }
        }
      }

      match /expenses/{expenseId} {
        allow read: if canReadContent(tripId);
        allow update: if isAdminEditor()
          && request.resource.data.get('createdByUid', null) == resource.data.get('createdByUid', null)
          && validExpense(request.resource.data);
        allow delete: if isAdminEditor();

        // 所有已綁定成員都可新增；建立者 UID 必須由目前登入者寫入。停用中的行程不可新增。
        allow create: if canReadContent(tripId)
          && tripActive(tripId)
          && request.resource.data.createdByUid == request.auth.uid
          && validExpense(request.resource.data);

        // 所有角色都不得在更新時竄改建立者 UID；owner/editor 可管理全部，
        // viewer 僅可修改自己建立的明細。停用中的行程不可修改。
        allow update: if tripActive(tripId)
          && ((canEdit(tripId)
              && request.resource.data.get('createdByUid', null) == resource.data.get('createdByUid', null)
              && validExpense(request.resource.data))
            || (canReadContent(tripId)
              && resource.data.get('createdByUid', null) == request.auth.uid
              && request.resource.data.get('createdByUid', null) == resource.data.get('createdByUid', null)
              && validExpense(request.resource.data)));

        // owner/editor 可刪除全部；viewer 僅可刪除自己建立的明細。停用中的行程不可刪除。
        allow delete: if tripActive(tripId)
          && (canEdit(tripId)
            || (canReadContent(tripId)
              && resource.data.get('createdByUid', null) == request.auth.uid));
      }

      // 邀請連結管理鏡像資料：只有統籌人可以查詢／列出自己行程的邀請連結清單，
      // 因為 shortlinks 集合本身禁止 list（避免被任意列舉代碼），所以另存一份在這裡供管理頁面使用。
      // 實際的連結解析（訪客用代碼打開連結）一律以 shortlinks/{code} 那份為準。
      match /inviteLinks/{code} {
        allow get, list: if isOwner(tripId) || isAdmin();
        allow create: if (isOwner(tripId) || (isAdminEditor() && recentlyAuthenticated()))
          && request.resource.data.type == 'tripInvite'
          && request.resource.data.tripId == tripId
          && request.resource.data.revoked == false
          && request.resource.data.createdBy == request.auth.uid
          && validInvite(request.resource.data, tripId);
        // 只能調整 revoked／expiresAt／label／updatedAt，其餘欄位（含建立者、建立時間、所屬行程）不可被竄改。
        allow update: if (isOwner(tripId) || isAdminEditor())
          && request.resource.data.type == resource.data.type
          && request.resource.data.tripId == resource.data.tripId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked', 'expiresAt', 'label', 'maxUses', 'updatedAt'])
          && validInvite(request.resource.data, tripId);
        // v21p4：跟 shortlinks/{code} 同一組邀請連結的鏡像資料，usedCount 也要能在核准 Transaction 內
        // 同步原子遞增，維持兩份資料一致；同樣只允許「只改 usedCount 且新值等於舊值 +1」。
        allow update: if isOwner(tripId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount'])
          && request.resource.data.usedCount == resource.data.get('usedCount', 0) + 1;
        allow delete: if isOwner(tripId) || isAdminEditor();
      }

      match /accessRequests/{requestId} {
        allow create: if signedIn()
          && requestId == request.auth.uid
          && request.resource.data.keys().hasOnly(['requestedUid', 'status', 'createdAt', 'inviteCode'])
          && request.resource.data.requestedUid == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.inviteCode is string
          && canRequestAccess(tripId);
        allow get: if signedIn()
          && (isOwner(tripId)
            || requestId == request.auth.uid);
        allow list: if isOwner(tripId) || isAdmin();
        allow update: if (
            isOwner(tripId)
            && request.resource.data.requestedUid == resource.data.requestedUid
            && request.resource.data.status in ['pending', 'approved', 'rejected']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'approvedMemberId', 'approvedAt', 'rejectedAt', 'updatedAt'
            ])
          )
          // 原申請者可將既有的 rejected／approved 申請重新送回 pending。
          // 僅允許修改 status 與 createdAt，保留原有審核欄位，避免申請者竄改其他資料。
          || (signedIn()
            && requestId == request.auth.uid
            && resource.data.requestedUid == request.auth.uid
            && (resource.data.status == 'rejected' || resource.data.status == 'approved')
            && request.resource.data.requestedUid == resource.data.requestedUid
            && request.resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'createdAt', 'inviteCode'])
            && canRequestAccess(tripId));
        allow delete: if false;
      }
    }

    // 管理員操作稽核紀錄：只有管理員能讀取與新增，且新增後不可修改或刪除。
    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.tripId is string
        && request.resource.data.keys().hasOnly(['adminUid', 'adminEmail', 'tripId', 'action', 'detail', 'createdAt']);
      allow update, delete: if false;
    }

    // 系統管理員名單：只能在 Firebase Console 手動新增/刪除文件（文件 ID = 管理員的 Google 登入 UID）。
    // 前端沒有任何寫入權限；且 list 禁止，避免任何人（含一般登入者）列舉出所有管理員的 UID。
    // get 只開放給「本人查自己是不是管理員」，admin.js 用這個判斷要不要顯示管理後台內容。
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /shortlinks/{code} {
      allow get: if signedIn();
      allow list: if false;
      // 行程分享代碼只能由該行程統籌人建立；同步清單代碼則由已登入使用者建立。
      allow create: if signedIn()
        && (
          (request.resource.data.type == 'tripInvite'
            && request.resource.data.tripId is string
            && (isOwner(request.resource.data.tripId) || (isAdminEditor() && recentlyAuthenticated()))
            && validInvite(request.resource.data, request.resource.data.tripId))
          || validSyncShortlink(request.resource.data)
        );
      // 邀請連結（tripInvite）可由該行程統籌人調整到期時間／撤銷或恢復啟用；
      // 其餘欄位（所屬行程、建立時間、建立者、連結種類）不可被竄改，其他類型的代碼仍完全不可更動。
      allow update: if signedIn()
        && resource.data.type == 'tripInvite'
        && (isOwner(resource.data.tripId) || isAdminEditor())
        && request.resource.data.type == resource.data.type
        && request.resource.data.tripId == resource.data.tripId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked', 'expiresAt', 'label', 'maxUses', 'updatedAt'])
        && validInvite(request.resource.data, resource.data.tripId);
      // v21p4：核准編輯權限申請時，由統籌人在同一個 Transaction 內原子讀取並遞增 usedCount，
      // 避免多筆申請同時核准時各自依據舊資料誤判「還沒達到次數上限」而一起超額通過。
      // 只允許「僅改 usedCount 且新值剛好等於舊值 +1」，不能藉此管道改動其他欄位或一次跳增多筆。
      allow update: if signedIn()
        && resource.data.type == 'tripInvite'
        && isOwner(resource.data.tripId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount'])
        && request.resource.data.usedCount == resource.data.get('usedCount', 0) + 1;
      // 邀請連結可由該行程統籌人刪除；系統管理員的 canEdit 權限可清理已知的舊版 6 碼邀請／同步代碼。
      // sync 代碼沒有 tripId，因此管理員只能透過已知代碼 get + delete，不能 list 全部 shortlinks，避免暴露其他使用者的跨裝置同步資料。
      allow delete: if signedIn()
        && ((resource.data.type == 'tripInvite' && isOwner(resource.data.tripId))
          || (isAdminEditor() && resource.data.type in ['tripInvite', 'sync']));
    }
  }
}
